{
  "manifest_version": 3,
  "name": "SnapForge — Screenshot & PII Annotator",
  "short_name": "SnapForge",
  "description": "Featherweight MV3 screenshot, PII blur annotator, full-page stitch, and WebM screen recorder with zero tracking or bloat.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SnapForge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ]
}
